<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= product && product.id ? 'Edit Product' : 'Add Product' %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="container">
    <header class="topbar">
      <h1><%= product && product.id ? '✏️ Edit Product' : '➕ Add Product' %></h1>
      <a href="/" class="btn">← Back to list</a>
    </header>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="<%= product && product.id ? '/products/edit/' + product.id : '/products/add' %>" class="form-card">
      <label>Product Name
        <input type="text" name="name" maxlength="100" required value="<%= product ? product.name : '' %>" />
      </label>

      <label>Category
        <input type="text" name="category" maxlength="100" value="<%= product ? (product.category || '') : '' %>" />
      </label>

      <label>Price (৳)
        <input type="number" step="0.01" min="0" name="price" required value="<%= product ? product.price : '' %>" />
      </label>

      <label>Quantity
        <input type="number" step="1" min="0" name="quantity" required value="<%= product ? product.quantity : '' %>" />
      </label>

      <label>Low Stock Alert Threshold
        <input type="number" step="1" min="0" name="low_stock_threshold" value="<%= product ? (product.low_stock_threshold || 5) : 5 %>" />
      </label>

      <button type="submit" class="btn btn-primary">Save Product</button>
    </form>
  </div>
</body>
</html>
